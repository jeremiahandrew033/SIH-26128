APP_ENV=development
APP_NAME=livestock-health-platform-api
APP_VERSION=0.1.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT Authentication — REQUIRED, generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Supabase Credentials (Placeholder - To be configured in Phase 1)
SUPABASE_URL=
SUPABASE_ANON_KEY=
